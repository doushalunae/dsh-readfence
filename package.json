{
  "name": "dsh-readfence",
  "version": "0.1.1",
  "description": "Read-side approval gate for DeepSeek Harness: allowlisted reads, per-session read modes, and a merged read/write permission control",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "permissions",
    "security",
    "sandbox"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doushalunae/dsh-readfence.git"
  },
  "homepage": "https://github.com/doushalunae/dsh-readfence#readme",
  "bugs": {
    "url": "https://github.com/doushalunae/dsh-readfence/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/all.test.mjs"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-session": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-session": {
      "optional": true
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  }
}
